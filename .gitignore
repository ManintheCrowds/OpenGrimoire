# Dependencies
node_modules

# Environment and secrets
.env
.env.local
.env*.local

# Build and cache
.next
out
*.tsbuildinfo

# Logs
*.log
npm-debug.log

# Local / personal brain map (vault merges; not committed by default)
public/brain-map-graph.local.json
# Operator/e2e backups of graph JSON under public/ (must not be world-readable static files)
public/brain-map-graph.json.*
public/brain-map-graph.local.json.*
# Finder/VS Code duplicates insert before .json (not after), so the .* suffix
# patterns above miss them. Keep the committed public/brain-map-graph.json.
public/brain-map-graph.local *.json
public/brain-map-graph.local-*.json
public/brain-map-graph *.json
public/brain-map-graph-*.json
public/brain-map-graph (*).json

# LLM-Wiki read-only mirror (operator sync; not SSOT — keep .gitkeep only)
public/wiki/**
!public/wiki/.gitkeep

# Local SQLite (alignment + survey)
/data/

# Private consulting / strategy research (not shipped in public clone; see docs/research/PRIVATE_RESEARCH_LAYOUT.md)
/docs/private/

# Playwright
playwright-report/
test-results/
